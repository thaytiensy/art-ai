{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "artaimithuat",
  "buildCommand": "cd app && npm install && npm run build",
  "outputDirectory": "app/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/tts",
      "destination": "/api/tts"
    },
    {
      "source": "/(.*)",
      "destination": "/app/dist/index.html"
    }
  ]
}
